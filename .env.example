NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/lequ_v6
LOG_LEVEL=info

# Production mode fails startup unless every launch-flow variable below is
# present. Inject secrets through the environment's secret manager; these
# development placeholders are intentionally unusable.
AUTH_JWT_SECRET=replace-with-at-least-32-bytes
OBJECT_STORE_GATEWAY_URL=http://127.0.0.1:3301
OBJECT_STORE_SIGNING_SECRET=replace-with-at-least-32-bytes
CONSUMER_AUTH_JWT_SECRET=replace-with-at-least-32-bytes
LIFE_CONSUMER_AUTH_JWT_SECRET=replace-with-at-least-32-bytes
PLATFORM_ADDRESS_ENCRYPTION_KEY=replace-with-32-byte-base64-key
SALES_IDENTITY_HASH_SECRET=replace-with-at-least-32-bytes
INTERNAL_WORKER_TOKEN=replace-with-a-runtime-secret

# Payment, refund, verification and reconciliation provider boundary.
COMMERCE_PROVIDER_GATEWAY_URL=http://127.0.0.1:3303
COMMERCE_PROVIDER_GATEWAY_TOKEN=replace-with-a-runtime-secret
COMMERCE_CALLBACK_SECRET=replace-with-at-least-32-bytes
VERIFICATION_TOKEN_SECRET=replace-with-at-least-32-bytes

# Customer-service knowledge, model, bounded tools and notification boundary.
CUSTOMER_SERVICE_KNOWLEDGE_URL=http://127.0.0.1:3304
CUSTOMER_SERVICE_KNOWLEDGE_TOKEN=replace-with-a-runtime-secret
CUSTOMER_SERVICE_MODEL_URL=http://127.0.0.1:3305
CUSTOMER_SERVICE_MODEL_TOKEN=replace-with-a-runtime-secret
CUSTOMER_SERVICE_BUSINESS_TOOLS_URL=http://127.0.0.1:3306
CUSTOMER_SERVICE_BUSINESS_TOOLS_TOKEN=replace-with-a-runtime-secret
WECOM_NOTIFICATION_GATEWAY_URL=http://127.0.0.1:3307
WECOM_NOTIFICATION_GATEWAY_TOKEN=replace-with-a-runtime-secret

# GEO/plugin isolated runtime.
GEO_PLUGIN_GATEWAY_URL=http://127.0.0.1:3308
GEO_PLUGIN_GATEWAY_TOKEN=replace-with-a-runtime-secret

# Mini-program provider, build and signed callback boundary.
MINI_PROGRAM_GATEWAY_URL=http://127.0.0.1:3309
MINI_PROGRAM_GATEWAY_TOKEN=replace-with-a-runtime-secret
MINI_PROGRAM_BUILDER_URL=http://127.0.0.1:3310
MINI_PROGRAM_BUILDER_TOKEN=replace-with-a-runtime-secret
MINI_PROGRAM_CALLBACK_TOKEN=replace-with-a-runtime-secret

# Multi-tenant Enterprise-WeCom callback configuration and member resolver.
# It resolves CorpID to secret-manager-backed callback settings and resolves
# each member to a current tenant/store-scoped identity and intake session.
WECOM_CONFIG_GATEWAY_URL=http://127.0.0.1:3313
WECOM_CONFIG_GATEWAY_TOKEN=replace-with-a-runtime-secret

# One-shot, tenant-scoped Worker. A scheduler invokes one run per active tenant.
WORKER_TENANT_ID=00000000-0000-4000-8000-000000000000
INTERNAL_API_URL=http://127.0.0.1:3000
OUTBOX_EVENT_GATEWAY_URL=http://127.0.0.1:3302
OUTBOX_EVENT_GATEWAY_TOKEN=replace-with-at-least-16-bytes
PRIVACY_DELETION_GATEWAY_URL=http://127.0.0.1:3311
PRIVACY_DELETION_GATEWAY_TOKEN=replace-with-a-runtime-secret
PRIVACY_EXPORT_GATEWAY_URL=http://127.0.0.1:3312
PRIVACY_EXPORT_GATEWAY_TOKEN=replace-with-a-runtime-secret
