API_HOST=127.0.0.1
API_PORT=8787
VITE_API_BASE_URL=/api/v1
# 支付连接器回调 HMAC 密钥；生产环境必须由密钥管理系统注入并定期轮换
PAYMENT_CONNECTOR_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
# 套餐核销码派生密钥；与支付回调密钥隔离，生产环境由密钥管理系统注入
CONSUMER_DEAL_CREDENTIAL_SECRET=replace-with-a-different-32-character-secret
SPEECH_CONNECTOR_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
IMAGE_RECOGNITION_CONNECTOR_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
