{
  "name": "@lequ/tool-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Server-side Tool Gateway for Harness/Adapter tool calls; re-verifies tenant/role/object state/amount/package/approval and never writes business tables directly.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../tooling/clean-dist.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@lequ/contracts": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0"
  }
}
