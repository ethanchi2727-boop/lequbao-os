{
  "name": "@lequ/harness-adapter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Stable Adapter between Lequ business layer and DeepSeek Harness runtime; upstream upgrades must not change session/task/event/audit contracts.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../tooling/clean-dist.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@lequ/contracts": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0"
  }
}
