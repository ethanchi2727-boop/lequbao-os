.page {
  padding: 24rpx 28rpx 40rpx;
}
.topbar {
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.brand {
  font-size: 38rpx;
  font-weight: 800;
  color: #17201c;
}
.city {
  margin-left: 18rpx;
  font-size: 24rpx;
  color: #66736d;
}
.ai {
  margin: 0;
  padding: 0 22rpx;
  height: 58rpx;
  line-height: 58rpx;
  border-radius: 29rpx;
  background: #e3f5ed;
  color: #0d8b62;
  font-size: 24rpx;
  font-weight: 700;
}
.hero {
  position: relative;
  height: 310rpx;
  border-radius: 30rpx;
  overflow: hidden;
  background: #0d8b62;
  box-shadow: 0 16rpx 38rpx rgba(23, 32, 28, 0.12);
}
.hero image {
  width: 100%;
  height: 100%;
}
.shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, rgba(5, 43, 31, 0.8), rgba(5, 43, 31, 0.08) 72%);
}
.hero-copy {
  position: absolute;
  left: 30rpx;
  top: 40rpx;
  width: 56%;
  color: #fff;
  display: flex;
  flex-direction: column;
}
.eyebrow {
  font-size: 22rpx;
  font-weight: 700;
  color: #c9f6e2;
}
.hero-title {
  margin-top: 12rpx;
  font-size: 44rpx;
  line-height: 1.18;
  font-weight: 900;
}
.hero-subtitle {
  margin-top: 16rpx;
  font-size: 23rpx;
  line-height: 1.5;
}
.category-scroll {
  margin: 24rpx -28rpx 0;
  width: auto;
}
.category-row {
  display: flex;
  padding: 0 28rpx 12rpx;
}
.category {
  flex: 0 0 132rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 22rpx;
  color: #35413c;
}
.sprite-window {
  width: 96rpx;
  height: 96rpx;
  overflow: hidden;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 8rpx 20rpx rgba(23, 32, 28, 0.08);
  position: relative;
}
.sprite {
  position: absolute;
  width: 384rpx;
  height: 384rpx;
}
.sprite-0,
.sprite-4,
.sprite-8,
.sprite-12 {
  left: 0;
}
.sprite-1,
.sprite-5,
.sprite-9,
.sprite-13 {
  left: -96rpx;
}
.sprite-2,
.sprite-6,
.sprite-10,
.sprite-14 {
  left: -192rpx;
}
.sprite-3,
.sprite-7,
.sprite-11,
.sprite-15 {
  left: -288rpx;
}
.sprite-0,
.sprite-1,
.sprite-2,
.sprite-3 {
  top: 0;
}
.sprite-4,
.sprite-5,
.sprite-6,
.sprite-7 {
  top: -96rpx;
}
.sprite-8,
.sprite-9,
.sprite-10,
.sprite-11 {
  top: -192rpx;
}
.sprite-12,
.sprite-13,
.sprite-14,
.sprite-15 {
  top: -288rpx;
}
.category text {
  margin-top: 9rpx;
  white-space: nowrap;
}
.section-head {
  margin: 34rpx 0 18rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}
.section-head > view {
  display: flex;
  flex-direction: column;
}
.section-title {
  font-size: 34rpx;
  font-weight: 850;
}
.section-note {
  font-size: 21rpx;
  color: #7a8781;
  margin-top: 4rpx;
}
.more {
  color: #0d8b62;
  font-size: 24rpx;
}
.product-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}
.product {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(23, 32, 28, 0.06);
}
.product image {
  width: 100%;
  height: 224rpx;
  background: #eef1ef;
}
.product-copy {
  padding: 16rpx;
  display: flex;
  flex-direction: column;
}
.tag {
  align-self: flex-start;
  padding: 5rpx 10rpx;
  border-radius: 8rpx;
  background: #e3f5ed;
  color: #0d8b62;
  font-size: 18rpx;
}
.product-title {
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.35;
  margin-top: 10rpx;
}
.detail {
  font-size: 21rpx;
  color: #66736d;
  margin-top: 7rpx;
  line-height: 1.45;
}
.price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
}
.price {
  font-size: 35rpx;
  font-weight: 900;
  color: #ff5a36;
}
.price text {
  font-size: 22rpx;
}
.cart-add {
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 50%;
  background: #ff5a36;
  color: #fff;
  font-size: 34rpx;
}
.group-card {
  display: flex;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(23, 32, 28, 0.06);
}
.group-card image {
  width: 250rpx;
  height: 220rpx;
}
.group-copy {
  padding: 18rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
}
.sold {
  font-size: 20rpx;
  color: #7a8781;
}
.trust {
  margin-top: 28rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #eaf7f1;
  color: #0d8b62;
  font-size: 24rpx;
  display: flex;
  justify-content: space-between;
}
.trust > text {
  font-weight: 800;
}
.trust view text {
  margin-left: 18rpx;
  font-size: 20rpx;
}
.state-card {
  margin-top: 24rpx;
  min-height: 380rpx;
  padding: 60rpx 34rpx;
  border-radius: 26rpx;
  background: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #66736d;
  text-align: center;
}
.state-title {
  font-size: 32rpx;
  color: #17201c;
  font-weight: 800;
  margin-bottom: 16rpx;
}
.state-icon {
  width: 92rpx;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 50%;
  background: #e3f5ed;
  color: #0d8b62;
  font-size: 32rpx;
  margin-bottom: 20rpx;
}
.secondary {
  margin-top: 28rpx;
  height: 84rpx;
  line-height: 84rpx;
  padding: 0 38rpx;
  border-radius: 42rpx;
  background: #fff3ee;
  color: #ff5a36;
  font-size: 26rpx;
}
.success {
  background: #eaf7f1;
}
.skeleton {
  width: 60%;
  height: 28rpx;
  margin: 12rpx;
  border-radius: 14rpx;
  background: linear-gradient(90deg, #edf0ee, #f7f8f7, #edf0ee);
  animation: pulse 1.2s infinite;
}
.skeleton.wide {
  width: 90%;
  height: 160rpx;
}
@keyframes pulse {
  50% {
    opacity: 0.45;
  }
}
