.cart-page {
  padding: 28rpx;
}
.heading {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 24rpx;
}
.heading text:first-child {
  font-size: 44rpx;
  font-weight: 800;
}
.heading text:last-child {
  color: #65716b;
}
.panel,
.group,
.summary {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.panel,
.copy {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.warning {
  border: 2rpx solid #e7a54b;
}
.title,
.store text:first-child {
  font-weight: 750;
}
.store {
  display: flex;
  justify-content: space-between;
  padding-bottom: 18rpx;
  border-bottom: 2rpx solid #eef1ef;
}
.item {
  padding: 22rpx 0;
  border-bottom: 2rpx solid #eef1ef;
}
.copy {
  margin-bottom: 16rpx;
}
.error {
  color: #b53b32;
}
.quantity {
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.quantity button {
  width: 64rpx;
  min-height: 56rpx;
  padding: 0;
}
.remove {
  margin: 14rpx 0 0;
  color: #7a312b;
  background: #fff1ee;
}
.summary {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
