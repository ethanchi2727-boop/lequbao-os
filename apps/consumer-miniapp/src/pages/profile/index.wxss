.profile-page {
  padding: 28rpx;
}
.heading {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 24rpx;
}
.heading text:first-child {
  font-size: 44rpx;
  font-weight: 800;
}
.heading text:last-child,
.muted {
  color: #65716b;
}
.panel {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.warning {
  border: 2rpx solid #e7a54b;
}
.title {
  font-weight: 750;
}
.order {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #eef1ef;
}
.order view {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.order view:last-child {
  text-align: right;
}
