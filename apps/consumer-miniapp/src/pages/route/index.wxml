<view class="route-page safe-bottom" wx:if="{{contract}}">
  <view class="route-hero"><text class="eyebrow">{{contract.id}} · 乐趣生活</text><text class="title">{{contract.title}}</text><text class="purpose">{{contract.purpose}}</text></view>
  <view wx:if="{{demoMode}}" class="state-switch"><text>演示模式 · 非真实业务数据 · 页面状态：{{state}}</text><button bindtap="nextState">验收下一个状态</button></view>
  <view wx:if="{{state === '加载中'}}" class="panel"><view class="skeleton"></view><view class="skeleton short"></view><text>正在安全加载…</text></view>
  <view wx:elif="{{state === '空数据'}}" class="panel"><text class="panel-title">暂时没有内容</text><text>你可以返回上一页或稍后重试</text></view>
  <view wx:elif="{{state === '局部错误'}}" class="panel warning"><text class="panel-title">部分信息未加载</text><text>可用内容仍然保留</text><button bindtap="retry">重试失败部分</button></view>
  <view wx:elif="{{state === '无权限'}}" class="panel warning"><text class="panel-title">暂时不能访问</text><text>需要身份绑定时会说明用途，不会越权展示订单</text></view>
  <view wx:elif="{{state === '停用'}}" class="panel warning"><text class="panel-title">服务已停用</text><text>查询、售后、申诉和客服入口仍然保留</text></view>
  <view wx:elif="{{state === '成功'}}" class="panel success"><text class="panel-title">已完成</text><text>关键结果已保存并有明确反馈</text></view>
  <view wx:elif="{{state === '可恢复失败'}}" class="panel warning"><text class="panel-title">这次没有完成</text><text>未重复扣款或提交，可以从安全断点继续</text><button bindtap="retry">从断点恢复</button></view>
  <view wx:elif="{{liveKind === 'orders' && liveData}}" class="panel content"><text class="panel-title">我的订单</text><view class="action" wx:for="{{liveData}}" wx:key="id" data-order-id="{{item.id}}" bindtap="openOrder"><text>{{item.storeName}} · {{item.orderNo}}</text><text>{{item.status}} · ¥{{item.payableAmountCents / 100}}</text></view></view>
  <view wx:elif="{{liveKind === 'order' && liveData}}" class="panel content"><text class="panel-title">{{liveData.storeName}} · {{liveData.orderNo}}</text><text>订单 {{liveData.status}} · 支付 {{liveData.paymentStatus}} · 履约 {{liveData.fulfillmentStatus}}</text><text>应付 ¥{{liveData.payableAmountCents / 100}} · 已付 ¥{{liveData.paidAmountCents / 100}} · 已退 ¥{{liveData.refundedAmountCents / 100}}</text><view class="action" wx:for="{{liveData.items}}" wx:key="id"><text>{{item.title}} × {{item.quantity}}</text><text>¥{{item.lineAmountCents / 100}}</text></view><button data-route="/life/page-239" data-order-id="{{liveData.id}}" bindtap="openOrderFeature">售后记录</button><button data-route="/life/page-245" data-order-id="{{liveData.id}}" bindtap="openOrderFeature">申请售后</button><button wx:if="{{liveData.verificationStatus !== 'NOT_APPLICABLE'}}" data-route="/life/page-243" data-order-id="{{liveData.id}}" bindtap="openOrderFeature">查看核销状态</button></view>
  <view wx:elif="{{liveKind === 'aftercare' && liveData}}" class="panel content"><text class="panel-title">售后进度</text><view class="action" wx:for="{{liveData.refunds}}" wx:key="id"><text>{{item.refundNo}} · {{item.status}}</text><text>退款 ¥{{item.amountCents / 100}} · 审批 {{item.approvalStatus || '无需审批'}}</text><text>原因 {{item.reasonCode}}</text><text>{{item.updatedAt}}</text></view></view>
  <view wx:elif="{{liveKind === 'verification' && liveData}}" class="panel content"><text class="panel-title">核销券与服务端状态</text><view class="action" wx:for="{{liveData}}" wx:key="entitlementId"><text>订单 {{item.orderId}}</text><text>{{item.status}} · 剩余 {{item.remainingUses}} 次</text><text wx:if="{{item.validUntil}}">有效至 {{item.validUntil}}</text><text class="token">{{item.verificationToken}}</text></view></view>
  <view wx:elif="{{liveKind === 'refundForm' && liveData}}" class="panel content"><text class="panel-title">申请售后 · {{liveData.orderNo}}</text><text>本次按各商品剩余可退数量申请，实际退款金额由服务端按已付分摊计算。</text><view class="action" wx:for="{{liveData.items}}" wx:key="id"><text>{{item.title}}</text><text>购买 {{item.quantity}} · 已退 {{item.refundedQuantity}}</text></view><input data-field="reasonCode" placeholder="售后原因（必填）" bindinput="updateRefundDraft"/><textarea data-field="description" placeholder="补充说明（选填）" bindinput="updateRefundDraft"></textarea><button bindtap="submitRefund">提交售后申请</button></view>
  <view wx:elif="{{liveKind === 'rewards' && liveData}}" class="panel content"><text class="panel-title">消费奖励明细</text><view class="action" wx:for="{{liveData}}" wx:key="id"><text>{{item.status}} · 可用 ¥{{item.availableAmountCents / 100}}</text><text>获得 ¥{{item.grantedAmountCents / 100}} · 已用 ¥{{item.redeemedAmountCents / 100}} · 已冲正 ¥{{item.reversedAmountCents / 100}}</text><text>{{item.fundingSource}} · 规则 {{item.ruleVersion}}</text><text wx:if="{{item.expiresAt}}">有效至 {{item.expiresAt}}</text></view></view>
  <view wx:elif="{{liveKind === 'checkout' && liveData}}" class="panel content"><text class="panel-title">订单确认 · {{liveData.groups.length}} 个商家分组</text><text>商品 ¥{{liveData.goodsAmountCents / 100}} + 运费 ¥{{liveData.shippingAmountCents / 100}} − 优惠 ¥{{liveData.discountAmountCents / 100}}</text><text>合计应付 ¥{{liveData.payableAmountCents / 100}}</text><text wx:if="{{liveData.rewardRedemptionStatus === 'UNAVAILABLE_PENDING_POLICY'}}">消费奖励抵扣尚未完成正式政策签字，本单不擅自抵扣</text><view class="action" wx:for="{{liveData.groups}}" wx:key="id" wx:for-item="group"><text>{{group.orderType}} · {{group.items.length}} 项 · {{group.status}}</text><text wx:if="{{contract.id === 'PAGE-227' && group.deliveryAddress}}">配送至 {{group.deliveryAddress.recipientName}} · {{group.deliveryAddress.mobile}} · {{group.deliveryAddress.addressLine}}</text><text wx:if="{{contract.id === 'PAGE-227' && !group.deliveryAddress}}">到店履约，无配送地址</text><text>运费 ¥{{group.shippingAmountCents / 100}} · 优惠 ¥{{group.discountAmountCents / 100}} · 应付 ¥{{group.payableAmountCents / 100}}</text><text>{{group.policy.refundRuleSummary}}</text><text wx:if="{{group.lastErrorCode}}">本组未创建：{{group.lastErrorCode}}，可安全重试</text><button wx:if="{{group.orderId}}" data-order-id="{{group.orderId}}" bindtap="openPayment">进入本商家支付</button></view><view class="action"><button data-route="/life/page-227" bindtap="openCheckoutSection">地址与配送</button><button data-route="/life/page-228" bindtap="openCheckoutSection">优惠与奖励</button><button data-route="/life/page-229" bindtap="openCheckoutSection">订单确认</button></view><button wx:if="{{contract.id === 'PAGE-229' && (liveData.status === 'QUOTED' || liveData.status === 'PARTIAL' || liveData.status === 'FAILED')}}" bindtap="submitCheckout">按商家创建订单</button><text wx:if="{{liveData.status === 'ORDERS_CREATED'}}">订单已创建；每个商家订单分别支付，本页不会把前端结果当作支付成功。</text></view>
  <view wx:elif="{{liveKind === 'paymentOrder' && liveData}}" class="panel content"><text class="panel-title">{{contract.id === 'PAGE-231' ? '微信支付' : '支付结果'}}</text><text>{{liveData.storeName}} · {{liveData.orderNo}}</text><text>应付 ¥{{liveData.payableAmountCents / 100}} · 服务端支付状态 {{liveData.paymentStatus}}</text><button wx:if="{{contract.id === 'PAGE-231' && liveData.status === 'PENDING_PAYMENT'}}" bindtap="startPayment">向该商家支付</button><text wx:if="{{contract.id === 'PAGE-232' && liveData.paymentStatus === 'PAID'}}">服务端已确认支付成功</text><text wx:elif="{{contract.id === 'PAGE-232'}}">支付确认中，请刷新；不会重复创建订单或把前端回调当成功。</text><button wx:if="{{contract.id === 'PAGE-232' && liveData.paymentStatus !== 'PAID'}}" bindtap="retry">刷新服务端结果</button></view>
  <view wx:elif="{{liveKind === 'addresses'}}" class="panel content"><text class="panel-title">配送地址</text><view class="action" wx:for="{{liveData}}" wx:key="id"><text>{{item.recipientName}} · {{item.mobile}}</text><text>{{item.provinceCode}} {{item.cityCode}} {{item.districtCode}} {{item.addressLine}}</text><text wx:if="{{item.isDefault}}">默认地址</text><button data-address-id="{{item.id}}" bindtap="archiveAddress">归档</button></view><input data-field="recipientName" placeholder="收件人" bindinput="updateAddressDraft"/><input data-field="mobile" type="number" placeholder="手机号" bindinput="updateAddressDraft"/><input data-field="provinceCode" placeholder="省编码" bindinput="updateAddressDraft"/><input data-field="cityCode" placeholder="市编码" bindinput="updateAddressDraft"/><input data-field="districtCode" placeholder="区编码" bindinput="updateAddressDraft"/><input data-field="addressLine" placeholder="详细地址" bindinput="updateAddressDraft"/><button bindtap="saveAddress">保存为默认地址</button></view>
  <view wx:elif="{{liveKind === 'product' && liveData}}" class="panel content"><text class="panel-title">{{liveData.title}}</text><text>价格：¥{{liveData.salePriceCents / 100}}</text><view class="action" wx:for="{{liveData.variants}}" wx:key="id"><text>{{item.title}}</text><text>{{item.available ? '可购买' : '暂时无货'}}</text></view><button bindtap="addToCart">加入跨商家购物车</button></view>
  <view wx:elif="{{liveKind === 'products' && liveData}}" class="panel content"><text class="panel-title">真实商品结果</text><view class="action" wx:for="{{liveData}}" wx:key="id" data-product-id="{{item.id}}" bindtap="openProduct"><text>{{item.title}}</text><text>{{item.productType}} · ¥{{item.salePriceCents / 100}}</text><text>{{item.variants.length}} 个有效规格</text></view></view>
  <view wx:elif="{{liveKind === 'storefront' && liveData}}" class="panel content"><text class="panel-title">{{liveData.name}}</text><text>地区 {{liveData.provinceCode || '未设置'}} · {{liveData.cityCode || '未设置'}} · {{liveData.districtCode || '未设置'}}</text><text>坐标 {{liveData.longitude || '未设置'}}，{{liveData.latitude || '未设置'}}</text><text>资料更新时间 {{liveData.updatedAt}}</text></view>
  <view wx:elif="{{liveKind === 'membership' && liveData}}" class="panel content"><text class="panel-title">会员首页</text><text>本商家会员 {{liveData.membership.status}} · 加入于 {{liveData.membership.memberSince}}</text><text>本商家可用奖励 ¥{{liveData.membership.availableRewardCents / 100}}</text><text>跨商家最近奖励 {{liveData.rewards.length}} 条 · 最近订单 {{liveData.orders.length}} 笔</text><text>奖励与支付资金严格分账，抵扣能力仍受正式政策门禁控制。</text></view>
  <view wx:elif="{{liveKind === 'conversation' && liveData}}" class="panel content"><text class="panel-title">乐趣生活客服</text><text>{{liveData.conversation ? liveData.conversation.status : '发送第一条消息后创建本人会话'}}</text><view class="action" wx:for="{{liveData.messages}}" wx:key="id"><text>{{item.senderType}} · {{item.contentPreviewRedacted}}</text><text>{{item.createdAt}}</text></view><textarea value="{{inputText}}" maxlength="4000" placeholder="输入商品、订单或售后问题" bindinput="onMessageInput"></textarea><button bindtap="sendCustomerMessage">发送</button><button wx:if="{{liveData.conversation && liveData.conversation.status === 'BOT_ACTIVE'}}" bindtap="requestHumanService">转人工</button><text>AI 会明确标识；人工接管后 AI 立即停止回复。</text></view>
  <view wx:elif="{{liveKind === 'conversations' && liveData}}" class="panel content"><text class="panel-title">我的工单</text><view class="action" wx:for="{{liveData}}" wx:key="id" data-conversation-id="{{item.id}}" bindtap="openConversation"><text>{{item.status}} · {{item.riskLevel}}</text><text>{{item.ticket ? ('工单 ' + item.ticket.status) : '暂无人工工单'}}</text><text>{{item.updatedAt}}</text></view></view>
  <view wx:elif="{{liveKind === 'profile' && liveData}}" class="panel content"><text class="panel-title">隐私与授权</text><text>档案状态 {{liveData.status}} · 持续档案授权 {{liveData.profileMemoryConsent}}</text><view class="action" wx:for="{{liveData.facts}}" wx:key="id"><text>{{item.factType}} · {{item.value}}</text><text>来源 {{item.sourceType}} · 用途 {{item.purpose}} · {{item.status}}</text></view><button wx:if="{{contract.id === 'PAGE-254'}}" bindtap="requestProfileView">申请查看档案副本</button><button wx:if="{{contract.id === 'PAGE-254' && liveData.profileMemoryConsent === 'GRANTED'}}" data-consent-type="PROFILE_MEMORY" data-status="WITHDRAWN" bindtap="changeLifeConsent">撤回持续档案授权</button><button wx:if="{{contract.id === 'PAGE-255'}}" data-consent-type="SUBSCRIPTION_MESSAGE" data-status="GRANTED" bindtap="changeLifeConsent">开启订单与服务通知</button><button wx:if="{{contract.id === 'PAGE-255'}}" data-consent-type="SUBSCRIPTION_MESSAGE" data-status="WITHDRAWN" bindtap="changeLifeConsent">关闭订阅消息</button></view>
  <view wx:elif="{{liveKind === 'discovery' && liveData}}" class="panel content"><text class="panel-title">真实门店推荐</text><button wx:if="{{contract.id === 'PAGE-216'}}" bindtap="locateNearbyStores">授权本次定位并按距离排序</button><view class="action" wx:for="{{liveData}}" wx:key="id"><text>{{item.name}} · {{item.cityCode || '城市未设置'}} {{item.districtCode || ''}}</text><text>{{item.distanceKm !== null ? (item.distanceKm + ' km') : (item.productCount + ' 个在售商品')}}</text><button wx:if="{{contract.id === 'PAGE-219' && item.latitude !== null && item.longitude !== null}}" size="mini" data-store="{{item}}" bindtap="openStoreMap">打开地图</button></view><text>推荐范围仅来自当前平台账号已建立客户关系的真实营业门店，不扩散个人位置。</text></view>
  <view wx:elif="{{liveKind === 'trace' && liveData}}" class="panel content"><text class="panel-title">{{liveData.title}}</text><text>{{liveData.summary}}</text><view class="action" wx:for="{{liveData.evidence}}" wx:key="type"><text>{{item.type}}</text><text>{{item.value}}</text></view><text>核验版本 {{liveData.reportVersion}} · 核验时间 {{liveData.verifiedAt}}</text><text wx:if="{{liveData.expiresAt}}">有效至 {{liveData.expiresAt}}</text></view>
  <view wx:elif="{{liveKind === 'invoices'}}" class="panel content"><text class="panel-title">发票抬头</text><view class="action" wx:for="{{liveData}}" wx:key="id"><text>{{item.profileType}} · {{item.title}}</text><text wx:if="{{item.taxIdentifier}}">税号 {{item.taxIdentifier}}</text><text wx:if="{{item.email}}">{{item.email}}</text><button data-profile-id="{{item.id}}" bindtap="archiveInvoiceProfile">归档</button></view><view><button size="mini" data-profile-type="PERSONAL" bindtap="setInvoiceType">个人</button><button size="mini" data-profile-type="ENTERPRISE" bindtap="setInvoiceType">企业</button></view><input data-field="title" placeholder="发票抬头" bindinput="updateInvoiceDraft"/><input wx:if="{{invoiceDraft.profileType === 'ENTERPRISE'}}" data-field="taxIdentifier" placeholder="纳税人识别号" bindinput="updateInvoiceDraft"/><input data-field="email" placeholder="接收邮箱（选填）" bindinput="updateInvoiceDraft"/><button bindtap="saveInvoiceProfile">加密保存抬头</button><text>抬头、税号和邮箱加密保存，仅本人有效平台会话可解密。</text></view>
  <view wx:else class="panel content"><text class="panel-title">主要任务</text><view class="action" wx:for="{{contract.actions}}" wx:key="*this"><text>{{index + 1}}</text><text>{{item}}</text></view><view class="domains" wx:if="{{contract.domains.length}}">数据边界：{{contract.domainsText}}</view></view>
  <button wx:if="{{demoMode}}" class="primary" disabled="{{state === '停用' || state === '无权限' || state === '加载中'}}" bindtap="primaryAction">完成演示操作</button>
  <view class="help"><text>规则说明</text><text>隐私授权</text><text>联系客服</text></view>
</view>
