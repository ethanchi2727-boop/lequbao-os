<view class="route-page safe-bottom" wx:if="{{contract}}">
  <view class="hero"><text>{{contract.id}} · 商家服务</text><text>{{contract.title}}</text><text>{{contract.purpose}}</text></view>
  <view wx:if="{{experience && liveKind}}" class="experience-context"><text class="experience-eyebrow">{{experience.eyebrow}}</text><text>{{experience.summary}}</text><view class="experience-actions"><button wx:for="{{experience.actions}}" wx:key="route" data-route="{{item.route}}" bindtap="openExperienceAction">{{item.label}}</button></view><text class="experience-guardrail">边界：{{experience.guardrail}}</text></view>
  <view wx:if="{{demoMode}}" class="state-switch"><text>演示模式 · 非真实业务数据 · 页面状态：{{state}}</text><button bindtap="nextState">验收下一个状态</button></view>
  <view wx:if="{{state === '加载中'}}" class="panel"><view class="skeleton"></view><text>正在加载本店实时信息…</text></view>
  <view wx:elif="{{state === '空数据'}}" class="panel"><text class="title">暂时没有内容</text><text>返回或稍后重试</text></view>
  <view wx:elif="{{state === '局部错误'}}" class="panel warning"><text class="title">部分信息未加载</text><text>可用内容仍保留</text><button bindtap="retry">重试失败部分</button></view>
  <view wx:elif="{{state === '无权限'}}" class="panel warning"><text class="title">需要完成身份绑定</text><text>查询本人订单前说明用途，不会越权</text></view>
  <view wx:elif="{{state === '停用'}}" class="panel warning"><text class="title">当前能力已停用</text><text>历史订单、售后和人工客服仍可使用</text></view>
  <view wx:elif="{{state === '成功'}}" class="panel success"><text class="title">操作成功</text><text>结果已由服务端确认并保存</text></view>
  <view wx:elif="{{state === '可恢复失败'}}" class="panel warning"><text class="title">这次没有完成</text><text>可以从安全断点继续，不会重复扣款</text><button bindtap="retry">安全恢复</button></view>
  <view wx:elif="{{liveKind === 'orders' && liveData}}" class="panel content"><text class="title">我的本店订单</text><view class="action" wx:for="{{liveData}}" wx:key="id" data-order-id="{{item.id}}" bindtap="openOrder"><text>{{item.orderNo}} · {{item.status}}</text><text>¥{{item.payableAmountCents / 100}} · {{item.fulfillmentStatus}}</text></view></view>
  <view wx:elif="{{liveKind === 'order' && liveData}}" class="panel content"><text class="title">{{liveData.orderNo}}</text><text>订单 {{liveData.status}} · 支付 {{liveData.paymentStatus}} · 履约 {{liveData.fulfillmentStatus}}</text><text>应付 ¥{{liveData.payableAmountCents / 100}} · 已退 ¥{{liveData.refundedAmountCents / 100}}</text><view class="action" wx:for="{{liveData.items}}" wx:key="id"><text>{{item.title}} × {{item.quantity}}</text><text>¥{{item.lineAmountCents / 100}}</text></view><button wx:if="{{contract.id === 'PAGE-289' && liveData.status === 'PENDING_PAYMENT'}}" data-route="/merchant/page-284" data-order-id="{{liveData.id}}" bindtap="openOrderFeature">去支付</button><button wx:if="{{contract.id === 'PAGE-284' && liveData.status === 'PENDING_PAYMENT'}}" bindtap="startPayment">向本商家支付</button><text wx:if="{{contract.id === 'PAGE-285' && liveData.paymentStatus === 'PAID'}}">服务端已确认支付成功</text><text wx:elif="{{contract.id === 'PAGE-285'}}">支付确认中，请刷新；前端支付回调不作为成功依据。</text><button wx:if="{{contract.id === 'PAGE-289'}}" data-route="/merchant/page-290" data-order-id="{{liveData.id}}" bindtap="openOrderFeature">售后记录</button><button wx:if="{{contract.id === 'PAGE-289' && liveData.verificationStatus !== 'NOT_APPLICABLE'}}" data-route="/merchant/page-294" data-order-id="{{liveData.id}}" bindtap="openOrderFeature">券码详情</button></view>
  <view wx:elif="{{liveKind === 'refunds' && liveData}}" class="panel content"><text class="title">退款进度</text><view class="action" wx:for="{{liveData}}" wx:key="id"><text>{{item.refundNo}} · {{item.status}}</text><text>¥{{item.amountCents / 100}} · {{item.reasonCode}}</text></view></view>
  <view wx:elif="{{liveKind === 'verification' && liveData}}" class="panel content"><text class="title">我的券</text><view class="action" wx:for="{{liveData}}" wx:key="entitlementId"><text>订单 {{item.orderId}}</text><text>{{item.status}} · 剩余 {{item.remainingUses}} 次</text><text wx:if="{{item.validUntil}}">有效至 {{item.validUntil}}</text><text>{{item.verificationToken}}</text></view></view>
  <view wx:elif="{{liveKind === 'product' && liveData}}" class="panel content"><text class="title">{{liveData.title}}</text><text>价格：¥{{liveData.salePriceCents / 100}}</text><view class="action" wx:for="{{liveData.variants}}" wx:key="id"><text>{{item.title}}</text><text>{{item.available ? '可购买' : '暂时无货'}}</text></view><button bindtap="addToCart">加入购物车</button></view>
  <view wx:elif="{{liveKind === 'storefront' && liveData}}" class="panel content"><text class="title">{{liveData.name}}</text><text>地区：{{liveData.provinceCode || '未设置'}} · {{liveData.cityCode || '未设置'}} · {{liveData.districtCode || '未设置'}}</text><text>营业时间：{{liveData.openingHoursText}}</text><text class="muted">门店资料更新时间 {{liveData.updatedAt}}；仅展示当前登录令牌绑定的真实门店。</text></view>
  <view wx:elif="{{liveKind === 'stores' && liveData}}" class="panel content"><text class="title">选择门店</text><view class="action" wx:for="{{liveData}}" wx:key="id"><view><text>{{item.name}}</text><text class="muted">{{item.cityCode || ''}} {{item.districtCode || ''}} · {{item.current ? '当前门店' : '可切换'}}</text></view><button size="mini" disabled="{{item.current}}" data-store-id="{{item.id}}" data-current="{{item.current}}" bindtap="switchMerchantStore">{{item.current ? '当前' : '切换'}}</button></view><text class="muted">切换成功会撤销旧门店会话并签发同到期时间的新会话。</text></view>
  <view wx:elif="{{liveKind === 'membership' && liveData}}" class="panel content"><text class="title">本商家会员</text><text>会员状态：{{liveData.status}} · 加入于 {{liveData.memberSince}}</text><text class="checkout-total">可用消费奖励 ¥{{liveData.availableRewardCents / 100}}</text><text>奖励账户：{{liveData.rewardAccountStatus}}</text><view class="action" wx:for="{{liveData.grants}}" wx:key="id"><view><text>{{item.status}} · 获得 ¥{{item.grantedAmountCents / 100}}</text><text class="muted">已用 ¥{{item.redeemedAmountCents / 100}} · 已撤回 ¥{{item.reversedAmountCents / 100}} · 规则 {{item.ruleVersion}}</text></view></view><text class="muted">金额以不可变奖励账本为准，不与支付余额混用。</text></view>
  <view wx:elif="{{liveKind === 'cart' && liveData}}" class="panel content"><text class="title">本店购物车</text><view wx:for="{{liveData.groups}}" wx:key="storeId"><text>{{item.storeName || '当前门店'}} · 小计 ¥{{item.subtotalCents / 100}}</text><view class="cart-item" wx:for="{{item.items}}" wx:for-item="cartItem" wx:key="id"><view><text>{{cartItem.productTitle}} · {{cartItem.variantTitle}}</text><text class="muted">{{cartItem.available ? '库存可用' : '商品或库存已变化'}}</text></view><view class="quantity"><button size="mini" data-item="{{cartItem}}" data-delta="-1" bindtap="changeCartQuantity">−</button><text>{{cartItem.quantity}}</text><button size="mini" data-item="{{cartItem}}" data-delta="1" bindtap="changeCartQuantity">+</button></view></view></view><button class="primary" bindtap="prepareCheckout">确认商品并结算</button></view>
  <view wx:elif="{{liveKind === 'checkout' && liveData}}" class="panel content"><text class="title">确认本店订单</text><text>商品 ¥{{liveData.goodsAmountCents / 100}} · 优惠 ¥{{liveData.discountAmountCents / 100}} · 配送 ¥{{liveData.shippingAmountCents / 100}}</text><text class="checkout-total">应付 ¥{{liveData.payableAmountCents / 100}}</text><view class="action" wx:for="{{liveData.groups}}" wx:key="id"><view><text>{{item.orderType}} · {{item.status}}</text><text class="muted">{{item.policy.refundRuleSummary || '退款规则以订单快照为准'}}</text></view></view><text class="muted">报价有效至 {{liveData.expiresAt}}；提交后仍以服务端创建结果为准。</text><button class="primary" disabled="{{liveData.status !== 'QUOTED'}}" bindtap="submitMerchantCheckout">提交订单</button></view>
  <view wx:elif="{{liveKind === 'conversation' && liveData}}" class="panel content"><text class="title">问问本店 AI 店员</text><text>{{liveData.conversation ? ('会话状态：' + liveData.conversation.status) : '发送第一条消息后创建本人会话'}}</text><view class="message" wx:for="{{liveData.messages}}" wx:key="id"><text>{{item.senderType}} · {{item.contentPreviewRedacted}}</text><text class="muted">{{item.createdAt}}</text></view><textarea value="{{inputText}}" maxlength="4000" placeholder="输入商品、订单或门店问题" bindinput="onMessageInput"></textarea><button bindtap="sendCustomerMessage">发送</button><button wx:if="{{liveData.conversation && liveData.conversation.status === 'BOT_ACTIVE'}}" bindtap="requestHumanService">转人工</button><text class="muted">AI 回答会明确标识；人工接管后 AI 立即停止回复。</text></view>
  <view wx:elif="{{liveKind === 'profile' && liveData}}" class="panel content"><text class="title">隐私与客户档案</text><text>档案状态：{{liveData.status}} · 持续档案同意：{{liveData.profileMemoryConsent}}</text><view class="action" wx:for="{{liveData.facts}}" wx:key="id"><view><text>{{item.factType}} · {{item.value}}</text><text class="muted">来源 {{item.sourceType}} · 用途 {{item.purpose}} · {{item.status}}</text></view></view><button bindtap="requestProfileView">申请查看档案副本</button><button wx:if="{{liveData.profileMemoryConsent === 'GRANTED'}}" bindtap="withdrawProfileMemory">撤回持续档案同意</button></view>
  <view wx:elif="{{liveKind === 'refundApply' && liveData}}" class="panel content"><text class="title">申请售后</text><text>{{liveData.orderNo}} · 已付 ¥{{liveData.paidAmountCents / 100}} · 已退 ¥{{liveData.refundedAmountCents / 100}}</text><view class="action" wx:for="{{liveData.items}}" wx:key="id"><text>{{item.title}} × {{item.quantity}}</text></view><button class="primary" disabled="{{liveData.paymentStatus !== 'PAID'}}" bindtap="requestFullRefund">申请全部可退商品</button><text class="muted">退款金额、可退数量和审批要求均由服务端按订单快照重新计算。</text></view>
  <view wx:elif="{{experience}}" class="panel content experience-panel"><text class="experience-eyebrow">{{experience.eyebrow}}</text><text class="title">{{contract.title}}</text><text class="experience-summary">{{experience.summary}}</text><view class="experience-fact" wx:for="{{experience.facts}}" wx:key="*this"><text>{{index + 1}}</text><text>{{item}}</text></view><view class="experience-actions"><button wx:for="{{experience.actions}}" wx:key="route" data-route="{{item.route}}" bindtap="openExperienceAction">{{item.label}}</button></view><text class="experience-guardrail">边界：{{experience.guardrail}}</text></view>
  <view wx:else class="panel content"><text class="title">主要任务</text><view class="action" wx:for="{{contract.actions}}" wx:key="*this"><text>{{index + 1}}</text><text>{{item}}</text></view><text class="domains" wx:if="{{contract.domains.length}}">数据边界：{{contract.domainsText}}</text></view>
  <button wx:if="{{demoMode}}" class="primary" disabled="{{state === '停用' || state === '无权限' || state === '加载中'}}" bindtap="primaryAction">完成演示操作</button>
  <view class="ai-disclosure"><text>AI 店员会明确标识；可随时转人工；订单查询前需身份绑定。</text></view>
</view>
