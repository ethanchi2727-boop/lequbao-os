.page {
  padding: 24rpx 28rpx 40rpx;
}
.header {
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.header > view {
  display: flex;
  align-items: center;
}
.merchant {
  font-size: 36rpx;
  font-weight: 900;
}
.verified {
  margin-left: 14rpx;
  padding: 5rpx 10rpx;
  border-radius: 8rpx;
  background: #e3f5ed;
  color: #0d8b62;
  font-size: 18rpx;
}
.header button {
  margin: 0;
  height: 58rpx;
  line-height: 58rpx;
  border-radius: 29rpx;
  padding: 0 22rpx;
  background: #e3f5ed;
  color: #0d8b62;
  font-size: 23rpx;
}
.hero {
  position: relative;
  height: 330rpx;
  border-radius: 28rpx;
  overflow: hidden;
}
.hero image {
  width: 100%;
  height: 100%;
}
.overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, rgba(15, 28, 22, 0.78), rgba(15, 28, 22, 0.05));
}
.hero-copy {
  position: absolute;
  left: 30rpx;
  top: 54rpx;
  width: 58%;
  color: #fff;
  display: flex;
  flex-direction: column;
}
.hero-copy text:first-child {
  font-size: 46rpx;
  font-weight: 900;
}
.hero-copy text:nth-child(2) {
  font-size: 25rpx;
  line-height: 1.45;
  margin-top: 12rpx;
}
.hero-copy view {
  margin-top: 24rpx;
  font-size: 20rpx;
  color: #d8f4e8;
}
.quick {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 20rpx;
}
.quick > view {
  padding: 22rpx;
  border-radius: 20rpx;
  background: #fff;
  display: flex;
  flex-direction: column;
}
.quick text:first-child {
  font-size: 27rpx;
  font-weight: 800;
}
.quick text:last-child {
  font-size: 20rpx;
  color: #66736d;
  margin-top: 5rpx;
}
.section-head {
  margin: 34rpx 0 18rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}
.section-head > view {
  display: flex;
  flex-direction: column;
}
.section-head > view text:first-child {
  font-size: 34rpx;
  font-weight: 900;
}
.section-head > view text:last-child {
  font-size: 20rpx;
  color: #66736d;
  margin-top: 4rpx;
}
.section-head > text {
  font-size: 22rpx;
  color: #0d8b62;
}
.product {
  display: flex;
  margin-bottom: 16rpx;
  padding: 14rpx;
  border-radius: 22rpx;
  background: #fff;
}
.product image {
  width: 210rpx;
  height: 190rpx;
  border-radius: 16rpx;
  margin-right: 18rpx;
}
.product > view {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.tag {
  align-self: flex-start;
  padding: 4rpx 9rpx;
  background: #e3f5ed;
  color: #0d8b62;
  border-radius: 8rpx;
  font-size: 18rpx;
}
.product-title {
  font-size: 28rpx;
  font-weight: 800;
  margin-top: 8rpx;
}
.detail {
  font-size: 20rpx;
  color: #66736d;
  margin-top: 7rpx;
  line-height: 1.4;
}
.price {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: auto;
}
.price text:first-child {
  font-size: 34rpx;
  font-weight: 900;
  color: #ff5a36;
}
.price text:last-child {
  font-size: 20rpx;
  color: #ff5a36;
}
.ai-notice {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: #eaf7f1;
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 8rpx 16rpx;
  align-items: center;
}
.ai-notice > text:first-child {
  font-weight: 900;
  color: #0d8b62;
}
.ai-notice > text:nth-child(2) {
  font-size: 21rpx;
  line-height: 1.45;
  color: #52605a;
}
.ai-notice button {
  grid-column: 1/3;
  margin: 14rpx 0 0;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 38rpx;
  background: #0d8b62;
  color: #fff;
  font-size: 24rpx;
}
.state {
  min-height: 400rpx;
  padding: 50rpx 30rpx;
  border-radius: 26rpx;
  background: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #66736d;
  text-align: center;
}
.state-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #17201c;
  margin-bottom: 15rpx;
}
.state button {
  margin-top: 24rpx;
  background: #fff3ee;
  color: #ff5a36;
  border-radius: 38rpx;
  font-size: 24rpx;
}
.state.success {
  background: #eaf7f1;
}
.skeleton {
  width: 90%;
  height: 180rpx;
  border-radius: 20rpx;
  background: #edf0ee;
  margin-bottom: 22rpx;
}
