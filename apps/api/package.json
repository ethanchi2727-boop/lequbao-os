    "@lequ/contracts": "workspace:*",
    "@lequ/harness-adapter": "workspace:*",
    "@lequ/tool-gateway": "workspace:*",
    "fastify": "5.12.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/pg": "8.21.0"
  }
}
