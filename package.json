{
  "name": "lequbao-v6-platform",
  "version": "6.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "contracts:check": "node tooling/verify-v6-contracts.mjs",
    "rbac:generate": "node tooling/generate-rbac-migration.mjs",
    "rbac:check": "node tooling/generate-rbac-migration.mjs --check",
    "release-plan:check": "node tooling/verify-release-readiness-plan.mjs",
    "release-50:check": "node tooling/verify-50-stage-plan.mjs",
    "acceptance:check": "node tooling/verify-acceptance-evidence.mjs",
    "launch:gate": "node tooling/verify-acceptance-evidence.mjs --launch",
    "controlled:preflight": "node tooling/controlled-environment-preflight.mjs",
    "controlled:inventory": "node tooling/controlled-environment-inventory.mjs",
    "controlled:prepare": "node tooling/prepare-controlled-evidence.mjs",
    "controlled:capture": "node tooling/capture-controlled-evidence.mjs",
    "controlled:assemble": "node tooling/assemble-controlled-results.mjs",
    "controlled:stage-release": "node tooling/controlled-evidence-package.mjs",
    "dev:mock-gateways": "node --env-file-if-exists=.env.development-mock.local tooling/development-mock-gateway.mjs",
    "dev:mock-check": "node tooling/development-mock-profile.mjs",
    "licenses:check": "node tooling/production-license-policy.mjs",
    "artifacts:check": "node tooling/production-artifact-policy.mjs",
    "v5:inventory": "node --experimental-sqlite tooling/v5-data-store-inventory.mjs",
    "visual:check": "node tooling/verify-visual-assets.mjs",
    "workbench:check": "node tooling/workbench-contract.mjs --verify",
    "openapi:check": "node tooling/verify-openapi.mjs",
    "sbom:generate": "node tooling/generate-sbom.mjs",
    "security:check": "node tooling/security-gate.mjs",
    "operations:check": "node tooling/verify-operations.mjs",
    "deployment:check": "node tooling/verify-deployment.mjs",
    "performance:gate": "node tooling/performance-gate.mjs",
    "typecheck": "pnpm --filter @lequ/contracts build && pnpm -r --if-present run typecheck",
    "test": "vitest run tooling && pnpm --filter @lequ/contracts build && pnpm -r --if-present run test",
    "build": "pnpm -r --if-present run build",
    "check": "pnpm format:check && pnpm lint && pnpm contracts:check && pnpm rbac:check && pnpm release-plan:check && pnpm release-50:check && pnpm acceptance:check && pnpm visual:check && pnpm workbench:check && pnpm openapi:check && pnpm security:check && pnpm operations:check && pnpm deployment:check && pnpm typecheck && pnpm test && pnpm build && pnpm artifacts:check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  }
}
